head(soil)
plot(soil$zinc, soil$lead)
plot(soil$zinc, soil$lead, xlab = "Zinc Concentration", ylab = "Lead Concentration")
plot(soil$zinc, soil$lead, xlab = "Zinc Concentration", ylab = "Lead Concentration", main = "Concentration of Lead vs Zinc (ppm)")
model <- lm(soil$zinc, soil$lead)
model <- lm(soil$lead ~ soil$zinc)
abline(model, col = "red", lwd = 2)
resid(model)
residuals <- resid(model)
plot(residuals, soil$zinc)
plot(soil$zinc, residuals)
abline(0,0)
abline(0,0, col = "blue", lwd = 2)
coef(model)
cor(soil$zinc, soil$lead)
